{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "serkandurusoy-com",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // Production is served only on the custom domains below; the workers.dev URL stays off
  // so the site has one canonical hostname. Preview URLs (per branch / PR) stay on.
  "workers_dev": false,
  "preview_urls": true,
  "routes": [
    { "pattern": "serkandurusoy.com", "custom_domain": true },
    { "pattern": "www.serkandurusoy.com", "custom_domain": true },
    { "pattern": "mta-sts.serkandurusoy.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
